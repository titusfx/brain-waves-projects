# Copy to .env to override. Every knob is prefixed EEG_.
EEG_ENVIRONMENT=local

# Where recordings and datasets are written. Defaults to the repository's
# recordings/ folder (the same one scripts/live_view.py writes to), so the CLI
# tools and this API share one library. Relative paths resolve against the
# repository root, not the process working directory.
# EEG_RECORDINGS_DIR=C:/Users/you/projects/brain-waves-projects/recordings

# idle | live | demo | replay   ("auto" tries the dongle, else stays idle)
EEG_DEFAULT_SOURCE=auto

# Sample rate of the EPOC+ stream. 128 Hz is the hardware's EEG rate.
EEG_FS=128

# WebSocket push rate and the analysis window the metrics are computed over.
EEG_TICK_HZ=10
EEG_WINDOW_SECONDS=2

# Dev-server origins allowed to call this API.
# EEG_CORS_ORIGINS=["http://localhost:4200"]
