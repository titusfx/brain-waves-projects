# openapi-typescript peers on TypeScript ^5, and Angular 22 ships TypeScript 6.
# It is a build-time code generator that only ever emits a .d.ts, so the peer range is
# stale rather than meaningful — and without this, `npm install` refuses to resolve at
# all. The alternative, `--force`, would silently drop the check instead of relaxing it.
legacy-peer-deps=true
save-exact=false
fund=false
